# ==============================================
# KONFIGURASI TELEGRAM BOT
# ==============================================
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_ganti_dengan_token_bot_anda

# Chat ID Telegram Anda (hanya chat ini yang bisa akses bot & menerima notif)
# Jika belum tahu, kosongkan dulu lalu jalankan bot & kirim /start ke bot Anda
TELEGRAM_CHAT_ID=

# ==============================================
# KONFIGURASI GMAIL IMAP (EMAIL NOTIF SEABANK)
# ==============================================
# Alamat Gmail yang menerima email notifikasi dari SeaBank
GMAIL_USER=emailanda@gmail.com

# App Password Gmail (16 karakter, BUKAN password login Gmail biasa!)
# Cara buat: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Host & Port IMAP Gmail (biarkan default untuk Gmail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Interval pengecekan email baru dalam detik (default: 180 detik / 3 menit agar aman dari limit koneksi Gmail)
EMAIL_POLL_INTERVAL_SECONDS=180

# Filter pengirim email SeaBank (pisahkan dengan koma)
SEABANK_SENDER_FILTERS=seabank.co.id,seabank

# Berapa hari ke belakang untuk scan email pada pengecekan (default: 1 hari)
# Deduplikasi otomatis menjamin email yang sama tidak tercatat dua kali
EMAIL_LOOKBACK_DAYS=1

# Kirim notifikasi debug ke Telegram jika ada email SeaBank yang gagal di-parse (true/false)
NOTIFY_UNPARSED_EMAIL=true

# ==============================================
# KONFIGURASI REKAP HARIAN & ZONA WAKTU
# ==============================================
# Zona waktu (WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura)
TIMEZONE=Asia/Jakarta

# Jadwal rekap harian otomatis (format cron: menit jam * * *)
# Default: "0 0 * * *" = setiap hari jam 00:00 WIB (merekap 24 jam penuh hari yang baru selesai)
# Contoh lain: "0 21 * * *" = jam 21:00 WIB
DAILY_RECAP_CRON=0 0 * * *

# ==============================================
# KONFIGURASI DATABASE & HEALTHCHECK SERVER
# ==============================================
# Lokasi file database SQLite
DATABASE_PATH=./data/finance.db

# Port HTTP healthcheck (berguna saat deploy ke Render/Railway)
PORT=3000
