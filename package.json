{
  "name": "notif-count-money",
  "version": "1.0.0",
  "description": "Bot Telegram otomatis untuk mencatat uang masuk, keluar, saldo, dan rekap harian dari notifikasi email SeaBank di Gmail.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
